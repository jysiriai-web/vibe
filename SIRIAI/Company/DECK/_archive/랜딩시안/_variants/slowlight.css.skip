/* ════════════════════════════════════════════
   느린 빛 / 분위기 — override layer
   배경이 20s+로 호흡 · 안개 걷히듯 답변 등장 · 영토별 빛의 온도/각도
   순수 CSS · 브랜드 토큰 파생 저채도 · 단일화면 유지
   ════════════════════════════════════════════ */

/* ── 빛 변수: data-q가 매번 각도·온도를 미세 변주한다 ── */
:root{
  --lx:16%; --ly:6%;          /* 따뜻한 빛(peach)의 위치 */
  --rx:88%; --ry:4%;          /* 차가운 빛(lilac)의 위치 */
  --warm:rgba(246,201,168,.40);
  --cool:rgba(221,208,239,.46);
  --breath:26s;               /* 호흡 주기 — 아주 느리게 */
}

/* 답변 영역은 빛이 닿는 종이여야 — 막아둔 흰 판을 살짝 투과시킨다 */
.right, .out{ background:transparent !important; }
.right-pad, .out > *{ position:relative; z-index:1; }

/* ════════ 1. 느린 호흡 — 배경 위 한 겹의 빛 ════════
   body 배경(fixed)은 그대로 두고, ::before 한 장이 transform/opacity로
   아주 느리게 떠다닌다. repaint 부담 없이 '살아있는 종이'. */
body::before{
  content:""; position:fixed; inset:-12%; z-index:0; pointer-events:none;
  background:
    radial-gradient(60% 52% at var(--lx) var(--ly), var(--warm), transparent 64%),
    radial-gradient(56% 50% at var(--rx) var(--ry), var(--cool), transparent 66%);
  mix-blend-mode:multiply;
  will-change:transform,opacity;
  animation:breathe var(--breath) var(--ease,cubic-bezier(.4,0,.12,1)) infinite alternate;
}
@keyframes breathe{
  0%  { transform:translate3d(0,0,0) scale(1);        opacity:.86; }
  50% { transform:translate3d(-1.4%,1%,0) scale(1.045); opacity:1; }
  100%{ transform:translate3d(1.2%,-.8%,0) scale(1.02); opacity:.9; }
}

/* ════════ 2. 그레인 + 비네트 — CSS만 ════════
   미세 격자형 그레인(반복 conic/radial)과 가장자리 비네트를 한 겹에.
   data-uri/이미지 없음. pointer-events 없음. */
body::after{
  content:""; position:fixed; inset:0; z-index:0; pointer-events:none;
  background:
    /* 비네트 — 가장자리로 갈수록 잉크가 아주 옅게 모인다 */
    radial-gradient(120% 120% at 50% 42%, transparent 58%, rgba(33,26,51,.05) 100%),
    /* 그레인 — 미세 점격자 두 장이 어긋나 정적 노이즈 인상 */
    radial-gradient(rgba(33,26,51,.05) .5px, transparent .6px) 0 0 / 3px 3px,
    radial-gradient(rgba(33,26,51,.035) .5px, transparent .6px) 1.5px 1.5px / 3px 3px;
  opacity:.55;
  mix-blend-mode:multiply;
}

/* 인트로에도 같은 호흡을 — 시작부터 분위기가 연속 */
#intro{ position:fixed; }
#intro::before{
  content:""; position:absolute; inset:-12%; z-index:0; pointer-events:none;
  background:
    radial-gradient(60% 52% at 14% 6%, var(--warm), transparent 64%),
    radial-gradient(56% 50% at 90% 4%, var(--cool), transparent 66%);
  mix-blend-mode:multiply;
  animation:breathe var(--breath) var(--ease,cubic-bezier(.4,0,.12,1)) infinite alternate;
}
#intro > *{ position:relative; z-index:1; }

/* ════════ 3. 안개 걷히듯 — 답변의 등장 ════════
   선택 직후 우측 답이 blur→clear로 풀린다. */
.answer, .out .head-sec, .out .body-sec{ }
.answer.show{ animation:fogclear 1.15s var(--ease,cubic-bezier(.4,0,.12,1)) both; }
.a-title, .a-head, .out h2{ animation:fogtitle .95s var(--ease,cubic-bezier(.4,0,.12,1)) both; }
.a-body, .out .ans{ animation:fogbody 1.3s var(--ease,cubic-bezier(.4,0,.12,1)) both; }
@keyframes fogclear{ from{opacity:0; filter:blur(9px)} to{opacity:1; filter:blur(0)} }
@keyframes fogtitle{ from{opacity:0; filter:blur(7px); transform:translateY(7px)} to{opacity:1; filter:blur(0); transform:none} }
@keyframes fogbody{ 0%{opacity:0; filter:blur(6px)} 35%{opacity:.4} 100%{opacity:1; filter:blur(0)} }

/* 후속/figure/grid도 안개에서 천천히 — 등장 토글 보존 */
.a-foot.in, .a-figure.in, .a-grid.in, .foot-cta, .followups{
  animation:fogbody 1.1s var(--ease,cubic-bezier(.4,0,.12,1)) both;
}

/* 커서는 빛 속에서 더 차분하게 */
.cursor{ background:var(--ink-2); opacity:.8; }

/* ════════ 4. 테크니컬 — mono 마이크로 라벨, 절제 ════════ */
.mono, .label, .crumb, .qcap, .fl, .stat .k, .foot .r, .a-num{
  font-feature-settings:"tnum" 1; opacity:.92;
}
.crumb, .out .crumb{ position:relative; }
/* 라벨 앞 미세 광점 — 정보 아님, 빛의 흔적 */
.crumb::before, .ql-cap::before{
  content:""; display:inline-block; width:4px; height:4px; border-radius:50%;
  margin-right:.7em; vertical-align:middle;
  background:radial-gradient(circle, var(--ink) 0 40%, transparent 60%);
  opacity:.4;
}

/* 질문 리스트: 빛이 닿으면 천천히 데워지듯 */
.qrow, .q{ transition:background var(--slow,.95s) var(--ease), border-color var(--med,.55s) var(--ease); }
.qrow.active, .q.on{ box-shadow:0 0 0 1px var(--hair), 0 18px 40px rgba(33,26,51,.10); }

/* ════════ 5. 영토별 빛의 각도·온도 (data-q="01".."05") ════════
   같은 종이, 다른 시간대의 빛. 후속질문도 영토를 유지한다. */

/* 01 레퍼런스 — 정오, 균형 잡힌 따뜻함 (기본에 가깝게) */
body[data-q="01"]{ --lx:18%; --ly:7%; --rx:86%; --ry:5%;
  --warm:rgba(246,201,168,.40); --cool:rgba(221,208,239,.44); }

/* 02 방식 — 이른 아침, 빛이 왼쪽에서 길게 들어옴 (cool 약간 후퇴) */
body[data-q="02"]{ --lx:9%; --ly:4%; --rx:94%; --ry:9%;
  --warm:rgba(246,201,168,.46); --cool:rgba(221,208,239,.36); --breath:30s; }

/* 03 선별 — 한낮, 빛이 높고 좁다 (양쪽이 위로 모임) */
body[data-q="03"]{ --lx:24%; --ly:2%; --rx:80%; --ry:2%;
  --warm:rgba(246,201,168,.36); --cool:rgba(221,208,239,.40); }

/* 04 해외 — 오후, lilac이 짙어지고 빛이 오른쪽으로 (먼 곳의 온도) */
body[data-q="04"]{ --lx:6%; --ly:10%; --rx:90%; --ry:3%;
  --warm:rgba(246,201,168,.30); --cool:rgba(221,208,239,.52); --breath:34s; }

/* 05 비용 — 저녁, peach가 낮게 내려앉고 빛이 가장 느리다 */
body[data-q="05"]{ --lx:14%; --ly:14%; --rx:84%; --ry:12%;
  --warm:rgba(246,201,168,.48); --cool:rgba(221,208,239,.34); --breath:38s; }

/* ════════ 6. 깊이별 미세 변주 (data-depth) ════════
   파고들수록 빛이 한 톤 가라앉고 비네트가 조여든다 — 집중. */
body[data-depth="1"]::after{ opacity:.62; }
body[data-depth="2"]::after{ opacity:.70; }
body[data-depth="3"]::after{ opacity:.78; }
body[data-depth="2"]::before,
body[data-depth="3"]::before{ opacity:.92; filter:saturate(.94); }
/* 깊을수록 답변이 더 천천히 갠다 */
body[data-depth="2"] .a-body, body[data-depth="2"] .out .ans{ animation-duration:1.5s; }
body[data-depth="3"] .a-body, body[data-depth="3"] .out .ans{ animation-duration:1.7s; }

/* ════════ 7. 장식 고스트 영토 번호 (텍스트 아님) ════════
   각 영토의 빛 속에 번호가 아주 옅게 비친다. 정보 과밀 아님. */
.a-head, .head-sec{ position:relative; }
.a-head::before, .head-sec::before{
  position:absolute; right:-1vw; top:-.34em; z-index:0;
  font-family:var(--serif); font-style:italic; line-height:1;
  font-size:21vh; color:rgba(33,26,51,.045); pointer-events:none;
  letter-spacing:-.02em;
}
body[data-q="01"] .a-head::before, body[data-q="01"] .head-sec::before{ content:"01"; }
body[data-q="02"] .a-head::before, body[data-q="02"] .head-sec::before{ content:"02"; }
body[data-q="03"] .a-head::before, body[data-q="03"] .head-sec::before{ content:"03"; }
body[data-q="04"] .a-head::before, body[data-q="04"] .head-sec::before{ content:"04"; }
body[data-q="05"] .a-head::before, body[data-q="05"] .head-sec::before{ content:"05"; }
/* 제목은 고스트 위로 */
.a-title, .a-head .a-title, .head-sec h2, .out h2,
.a-num, .crumb, .head-sec .crumb{ position:relative; z-index:1; }

/* ════════ 8. 모바일(<=860) — 장식은 물러난다 ════════
   절대배치 고스트 제거, 호흡/그레인 약화, 단일화면 가정 해제 대응 */
@media(max-width:860px){
  .a-head::before, .head-sec::before{ display:none; }
  body::before, #intro::before{ inset:-6%; animation-duration:32s; opacity:.7; }
  body::after{ opacity:.4; }
  .answer.show{ animation-duration:.9s; }
}
/* 데스크탑 더 좁은 분기(데모 기준)도 안전하게 */
@media(max-width:820px){
  .a-head::before, .head-sec::before{ display:none; }
}

/* prefers-reduced-motion: base가 이미 무력화 — 빛만 정지시켜 잔상 방지 */
@media(prefers-reduced-motion:reduce){
  body::before, #intro::before{ animation:none; opacity:.92; }
  .answer.show, .a-title, .a-head, .a-body, .out .ans,
  .out h2, .a-foot.in, .a-figure.in, .a-grid.in, .foot-cta, .followups{
    animation:none; filter:none; opacity:1; transform:none;
  }
}