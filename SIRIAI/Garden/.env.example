# ── SIRIAI 가드닝 대시보드 환경변수 ──
# 이 파일(.env.example)은 템플릿입니다. 실제 값은 .env 에 넣으세요 (.env 는 git 에 안 올라감).

# smmkings.com API 키 (계정 → API 페이지에서 발급)
SMMKINGS_API_KEY=

# SMM API 엔드포인트 (보통 그대로 두면 됨)
SMM_API_URL=https://smmkings.com/api/v2
SMM_SERVICE_ID=3697

# 가드닝 목표값 (사용자 지정)
TARGET_FOLLOWERS=1100
MIN_FOLLOWERS=1000

# 구글 시트 연동 (Apps Script 웹앱 방식)
SHEET_WEBAPP_URL=
SHEET_TOKEN=grdn_2f8a91c4e7b3

# (선택) 스캐너를 특정 프록시(다른 나라)로 내보내기 — 틱톡 차단 우회용.
# 시스템 VPN 을 켜두면 크롬이 알아서 그 연결을 타므로 보통은 불필요. 이건 '스캐너만' 프록시로 보낼 때.
#   예) TIKTOK_PROXY=http://호스트:포트   또는  http://아이디:비번@호스트:포트   또는  socks5://호스트:포트
TIKTOK_PROXY=
